# Copy to .env for LOCAL development only:  cp .env.example .env
# .env is gitignored. In production every value below is set in
# Vercel → Project → Settings → Environment Variables — never commit real keys.

# --- AI providers (free tiers; keep NO payment card on these accounts) -------
# Groq: https://console.groq.com/keys
GROQ_API_KEY=
# Tavily: https://app.tavily.com  (1,000 free credits / month)
TAVILY_API_KEY=
# Optional model overrides (defaults shown). Groq retired llama-3.1-8b-instant
# for free keys on 2026-08-16; openai/gpt-oss-20b is its recommended replacement.
# GROQ_FAST_MODEL=openai/gpt-oss-20b
# GROQ_DEEP_MODEL=openai/gpt-oss-120b

# --- Database (Turso free tier). Leave unset locally to use searchiq_local.db --
# TURSO_DATABASE_URL=libsql://<db>-<org>.turso.io
# TURSO_AUTH_TOKEN=

# --- Sessions: signs the guest/user cookie. REQUIRED on Vercel. -------------
# python3 -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# --- Optional Google sign-in -------------------------------------------------
# OAuth client (Web application) redirect URIs:
#   http://localhost:5001/auth/callback
#   https://<your-app>.vercel.app/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Live rewrite (optional) ------------------------------------------------
# Prepaid OpenRouter key for rewriting flagged answers (pinned to Groq, no
# fallbacks). Without it, rewrites use the free Groq key and may wait for capacity.
OPENROUTER_API_KEY=
# SEARCHIQ_REWRITE_MODEL=openai/gpt-oss-20b

# --- Caps (defaults shown; see limits.py) -------------------------------------
# GUEST_DAILY_CAP=3
# GUEST_IP_DAILY_CAP=10
# USER_DAILY_CAP=10
# SITE_DAILY_CAP=25
# SITE_MONTHLY_CAP=900
# FAST_DAILY_TOKENS=150000
# DEEP_DAILY_TOKENS=150000
# CACHE_TTL_DAYS=7

# --- Local-only testing switches (ignored on Vercel) ---------------------------
# SEARCHIQ_FAKE_PROVIDERS=1      canned answers + search results, no keys needed
# SEARCHIQ_SIMULATE_GROQ_429=1   every Groq call fails with a simulated 429
